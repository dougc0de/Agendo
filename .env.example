# Backend runtime
PORT=3000
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_COOKIE_NAME=agendo_refresh
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Frontend / desarrollo
# En desarrollo con Vite, la app usa proxy local y normalmente VITE_API_URL puede quedar vacia.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Migraciones remotas de Supabase
# Flujo oficial del repo:
# npm run db:push:remote
# npm run db:push:remote:dry
#
# Este flujo usa SUPABASE_DB_URL y no requiere `supabase login`.
# Variables legacy como DB_HOST / DB_USER / DB_PASSWORD / DB_NAME / DB_PORT
# no participan en el runtime actual ni en `db push`.
